{
  "scope": "read-only localhost readiness; no inference, audio or consequential action",
  "base_url": "http://127.0.0.1:8000",
  "checks": {
    "/health": {
      "http_status": 200
    },
    "/ui/": {
      "http_status": 200
    },
    "/api/ai/status": {
      "http_status": 200,
      "configuration": {
        "mode": "enhanced",
        "provider": "baseten",
        "models": {
          "text": "meta-models/muse-spark-open-1026",
          "vision": "meta-models/muse-spark-open-1026",
          "segmentation": "sam-3.1",
          "image": "muse-image-1.0"
        },
        "key_configured": true,
        "budget_limit_usd": 30
      }
    },
    "/api/frontline/auth/verify": {
      "http_status": 200,
      "role": "service"
    },
    "unauthenticated_interactions": {
      "http_status": 401
    }
  }
}
